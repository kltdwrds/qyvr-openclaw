#!/bin/sh
# The qyvr CLI (asks, actions, grants) as Nick. Like bin/buzz, the key reaches only this process's environment.
set -eu
here=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
state=${OPENCLAW_STATE_DIR:-/var/lib/plow}
if [ ! -r "$state/buzz/key" ]; then
  echo 'not_ready: no homeroom key yet; the buzz channel creates it at startup' >&2
  exit 3
fi
BUZZ_PRIVATE_KEY=$(cat "$state/buzz/key")
QYVR_HOME=$state/qyvr
QYVR_CONTROL_URL=${BUZZ_ATTESTATION_PROVIDER:-}
BUZZ_RELAY_URL=$(cat "$state/buzz/relay-url" 2>/dev/null || true)
export BUZZ_PRIVATE_KEY QYVR_HOME QYVR_CONTROL_URL BUZZ_RELAY_URL
exec node "$here/vendor/qyvr/qyvr.mjs" "$@"
