# LOCAL DEV ONLY: anyone who can reach localhost:3001 is admin of this agent.
:3001 {
	request_header -X-Plow-*
	request_header -X-Forwarded-*
	request_header -Forwarded
	request_header -X-Real-IP

	reverse_proxy 127.0.0.1:3000 {
		header_up Host 127.0.0.1:3000
		header_up X-Plow-User dev-owner
	}
}
